PORT=3000
APP_ORIGIN=http://localhost:4200
LOG_LEVEL=warn
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
DATABASE_URL=postgresql://soir:soir@localhost:5433/soir?schema=public
ORVIAN_ADMIN_USER=admin
ORVIAN_ADMIN_EMAIL=admin@orvian.local
ORVIAN_ADMIN_PASSWORD=change-me-before-running
ORVIAN_UPLOAD_DIR=data/uploads
MEDIA_STORAGE=local

# Use somente quando MEDIA_STORAGE=s3
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
